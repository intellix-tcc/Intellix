<mxfile host="app.diagrams.net"><diagram id="hex-intellix" name="Arquitetura Hexagonal"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Intellix — Arquitetura Hexagonal (Portas e Adaptadores)" style="text;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;fontColor=#4B2E83;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="O núcleo depende de contratos, não de implementações: o interpretador de perguntas é trocável por configuração,&#10;e o acesso ao banco passa por um único ponto, com consultas pré-definidas." style="text;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="210" y="54" width="1000" height="40" as="geometry"/></mxCell><mxCell id="legend" value="Entrada (driving): quem aciona o núcleo — API e importação    ·    Saída (driven): o que o núcleo aciona — NLU e dados&#10;──▶ chamada em tempo de execução    ·    - - -▷ o adaptador implementa o contrato da porta (dependência de código aponta para o núcleo)" style="text;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="790" width="1040" height="44" as="geometry"/></mxCell><mxCell id="core" value="NÚCLEO / DOMÍNIO&#10;&#10;&#10;Regras de análise de vendas&#10;&#10;Orquestração da pergunta&#10;&#10;Verificação de confiança&#10;&#10;Modelo de resposta (ResultSet)" style="shape=hexagon;perimeter=hexagonPerimeter2;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#4B2E83;strokeColor=#3d2568;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="380" height="340" as="geometry"/></mxCell><mxCell id="ator" value="ATOR&#10;Usuário → Frontend React (Vercel)" style="rounded=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#F2F2F2;strokeColor=#9aa0a6;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="230" height="70" as="geometry"/></mxCell><mxCell id="fastapi" value="ADAPTADOR PRIMÁRIO (entrada)&#10;API REST — FastAPI&#10;(app/main.py · /chat · /import)&#10;valida o token e limita requisições" style="rounded=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#E8F0FE;strokeColor=#7a9bd4;" vertex="1" parent="1"><mxGeometry x="110" y="350" width="230" height="100" as="geometry"/></mxCell><mxCell id="portaEntrada" value="Porta de entrada&#10;«perguntar»" style="rounded=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#EAD9B0;strokeColor=#b89b5e;fontColor=#3a2a10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="190" height="56" as="geometry"/></mxCell><mxCell id="nluNote" value="trocáveis pela variável  NLU_BACKEND" style="text;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1055" y="205" width="320" height="24" as="geometry"/></mxCell><mxCell id="portaNLU" value="Porta de NLU «interpretar»&#10;contrato NLUService&#10;(app/nlu/base.py)" style="rounded=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#EAD9B0;strokeColor=#b89b5e;fontColor=#3a2a10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="311" width="185" height="64" as="geometry"/></mxCell><mxCell id="admRegras" value="ADAPTADOR · NLU por regras&#10;(app/nlu/regras.py)" style="rounded=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;fillColor=#E9F5EF;strokeColor=#79b79f;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="30