digraph DER {
graph [rankdir=TB, nodesep=0.25, ranksep=0.45, splines=spline, fontname="Arial", pad=0.15];
node [shape=plain, fontname="Arial", fontsize=12];
edge [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#333333", arrowsize=0.8];
empresa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>empresa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criada_em">criada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dono_id">dono_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR></TABLE>>];
dim_data [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>dim_data</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data">data</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dia">dia</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mes">mes</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trimestre">trimestre</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ano">ano</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR></TABLE>>];
dim_produto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>dim_produto</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_norm">nome_norm</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR></TABLE>>];
dim_cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>dim_cliente</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_norm">nome_norm</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="segmento">segmento</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR></TABLE>>];
dim_vendedor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>dim_vendedor</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_norm">nome_norm</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR></TABLE>>];
importacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>importacao</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_arquivo">nome_arquivo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hash_arquivo">hash_arquivo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="linhas_lidas">linhas_lidas</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="linhas_validas">linhas_validas</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="linhas_rejeitadas">linhas_rejeitadas</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criada_em">criada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">timestamptz</FONT></TD></TR></TABLE>>];
staging_venda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>staging_venda</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="importacao_id">importacao_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="linha_origem">linha_origem</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_venda">data_venda</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="produto">produto</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cliente">cliente</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vendedor">vendedor</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="canal">canal</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="forma_pagamento">forma_pagamento</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_unitario">valor_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="desconto">desconto</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_total">valor_total</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="erros">erros</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR></TABLE>>];
fato_item_venda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>fato_item_venda</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venda_id">venda_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_id">data_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="produto_id">produto_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cliente_id">cliente_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vendedor_id">vendedor_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="canal">canal</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="forma_pagamento">forma_pagamento</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade">quantidade</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_unitario">valor_unitario</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="desconto">desconto</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_total">valor_total</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="origem_importacao">origem_importacao <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR></TABLE>>];
log_consulta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>log_consulta</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="empresa_id">empresa_id <B>(FK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criado_em">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pergunta">pergunta</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intencao">intencao</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entidades">entidades</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="confianca">confianca</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="template_sql">template_sql</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="parametros">parametros</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tempo_ms">tempo_ms</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR></TABLE>>];
conversa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLUMNS="*" ROWS="*"><TR><TD COLSPAN="2" BGCOLOR="#D9D9D9"><B>conversa</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U> <B>(PK)</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dono_id">dono_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo">titulo</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mensagens">mensagens</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criada_em">criada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atualizada_em">atualizada_em</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">timestamptz</FONT></TD></TR></TABLE>>];
{rank=same; empresa; conversa;}
{rank=same; dim_data; dim_cliente; importacao;}
{rank=same; dim_produto; dim_vendedor; staging_venda;}
dim_data -> dim_produto [style=invis]; dim_cliente -> dim_vendedor [style=invis];
empresa -> dim_produto:empresa_id;
empresa -> dim_cliente:empresa_id;
empresa -> dim_vendedor:empresa_id;
empresa -> importacao:empresa_id;
empresa -> staging_venda:empresa_id;
importacao -> staging_venda:importacao_id;
dim_cliente -> fato_item_venda:cliente_id;
dim_data -> fato_item_venda:data_id;
empresa -> fato_item_venda:empresa_id;
importacao -> fato_item_venda:origem_importacao;
dim_produto -> fato_item_venda:produto_id;
dim_vendedor -> fato_item_venda:vendedor_id;
empresa -> log_consulta:empresa_id;
}