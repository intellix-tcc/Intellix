{
  "openapi": "3.1.0",
  "info": {
    "title": "Intellix API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pergunta"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/import": {
      "post": {
        "summary": "Import Planilha",
        "description": "Recebe o .xlsx do frontend (campo `arquivo`), valida e carrega no star\nschema. A resposta traz linhas_lidas/validas/rejeitadas -- campos que o\n`frontend/src/paginas/Importar.jsx` já lê. Mesmo padrão de erro do\nexecutor.py: nada de stack trace do Postgres vaza para o cliente.",
        "operationId": "import_planilha_import_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_planilha_import_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Import Planilha Import Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_import_planilha_import_post": {
        "properties": {
          "arquivo": {
            "type": "string",
            "format": "binary",
            "title": "Arquivo"
          }
        },
        "type": "object",
        "required": [
          "arquivo"
        ],
        "title": "Body_import_planilha_import_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Pergunta": {
        "properties": {
          "pergunta": {
            "type": "string",
            "title": "Pergunta"
          }
        },
        "type": "object",
        "required": [
          "pergunta"
        ],
        "title": "Pergunta"
      },
      "ResultSet": {
        "properties": {
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "colunas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Colunas"
          },
          "linhas": {
            "items": {
              "items": {},
              "type": "array"
            },
            "type": "array",
            "title": "Linhas"
          },
          "tipo_visualizacao": {
            "type": "string",
            "title": "Tipo Visualizacao"
          },
          "parametros": {
            "type": "object",
            "title": "Parametros",
            "default": {}
          },
          "confianca": {
            "type": "number",
            "title": "Confianca",
            "default": 1.0
          },
          "gerado_em": {
            "type": "string",
            "title": "Gerado Em"
          }
        },
        "type": "object",
        "required": [
          "titulo",
          "colunas",
          "linhas",
          "tipo_visualizacao",
          "gerado_em"
        ],
        "title": "ResultSet",
        "description": "O que o backend devolve para o frontend. Fronteira B -> D.\n\nPassa por aqui TUDO: tela, Excel e PDF. Valores numericos ficam como\nnumero (ex.: 48231.50), nunca formatados como texto (ex.: \"R$ 48.231,50\")."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}