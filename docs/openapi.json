  "components": {
    "schemas": {
      "Body_import_planilha_import_post": {
        "properties": {
          "arquivo": {
            "type": "string",
            "format": "binary",
            "title": "Arquivo"
          }
        },
        "type": "object",
        "required": [
          "arquivo"
        ],
        "title": "Body_import_planilha_import_post"
      },
      "Contexto": {
        "properties": {
          "intencao": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Intencao"
          },
          "entidades": {
            "type": "object",
            "title": "Entidades",
            "default": {}
          }
        },
        "type": "object",
        "title": "Contexto",
        "description": "Resumo da resposta anterior, reenviado pelo frontend para dar\ncontinuidade à conversa (ver app/contexto.py). `intencao` e `entidades`\nsaem do ResultSet anterior (campos `intencao` e `parametros`)."
      },
      "ConversaPayload": {
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Titulo"
          },
          "mensagens": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Mensagens"
          },
          "criadoEm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Criadoem"
          }
        },
        "type": "object",
        "required": [
          "titulo"
        ],
        "title": "ConversaPayload",
        "description": "Corpo do PUT /conversas/{id}: a conversa inteira como o frontend a\nmantém (título + mensagens). O id vem na URL; o dono, do token. Aceita\ntanto `criadoEm` (nome do objeto no frontend) quanto `criado_em`."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Pergunta": {
        "properties": {
          "pergunta": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Pergunta"
          },
          "empresa_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Empresa Id"
          },
          "contexto": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Contexto"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "pergunta"
        ],
        "title": "Pergunta"
      },
      "ResultSet": {
        "properties": {
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "colunas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Colunas"
          },
          "linhas": {
            "items": {
              "items": {},
              "type": "array"
            },
            "type": "array",
            "title": "Linhas"
          },
          "tipo_visualizacao": {
            "type": "string",
            "title": "Tipo Visualizacao"
          },
          "parametros": {
            "type": "object",
            "title": "Parametros",
            "default": {}
          },
          "confianca": {
            "type": "number",
            "title": "Confianca",
            "default": 1.0
          },
          "gerado_em": {
            "type": "string",
            "title": "Gerado Em"
          },
          "intencao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intencao"
          },
          "evolucao": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evolucao"
          },
          "mensagem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mensagem"
          }
        },
        "type": "object",
        "required": [
          "titulo",
          "colunas",
          "linhas",
          "tipo_visualizacao",
          "gerado_em"
        ],
        "title": "ResultSet",
        "description": "O que o backend devolve para o frontend. Fronteira B -> D.\n\nPassa por aqui TUDO: tela, Excel e PDF. Valores numericos ficam como\nnumero (ex.: 48231.50), nunca formatados como texto (ex.: \"R$ 48.231,50\")."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
