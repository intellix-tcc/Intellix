# Copie este arquivo para ".env" (fora do Git) e preencha com os dados reais.
#
# No Supabase: Project Settings -> Database -> Connection string -> aba
# "Transaction" (pooler, porta 6543). NAO use a porta 5432 direta -- o
# Render/ambientes serverless falham nela (ver dev-b-backend.md).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# MVP de tenant unico (sem login ainda): id da empresa usada em toda consulta.
EMPRESA_ID=00000000-0000-0000-0000-000000000001