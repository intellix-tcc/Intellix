# Copie para ".env.local" (fora do Git). Na Vercel, cadastre as mesmas
# variáveis em Settings -> Environment Variables.

# Endereço do backend (FastAPI).
VITE_API_URL=http://127.0.0.1:8000

# Login (Supabase Auth): Project Settings -> API (ou "API Keys").
# A chave "anon"/"publishable" é PÚBLICA por natureza e pode ir para o
# navegador. NUNCA coloque aqui a "service_role"/"secret".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# "true" usa respostas e login simulados, sem servidor nenhum.
VITE_MOCK=false
